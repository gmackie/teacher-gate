{
  "name": "teacher-gate-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "demo": "node apps/demo/scripts/dev.mjs",
    "test:a11y": "pnpm --filter @teacher-gate/demo exec playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
